# Kopieer naar .env voor lokaal draaien. Op Azure zijn dit Application settings
# (docs/AZURE-SETUP.md §4). Nooit .env committen.

# Waar de SQLite-database en de snapshots staan. Lokaal ./data, op Azure /home/data.
DATA_DIR=./data

# Wie mag inloggen op /beheer (komma's ertussen).
BEHEER_EMAILS=jij@voorbeeld.nl

# Het domein van het beheer. Lokaal werkt localhost altijd, ongeacht deze waarde.
BEHEER_HOST=ty-luwa.nl

# Mail. Weglaten of "console" = alleen loggen in de terminal (ook de inlogcode).
# MAIL_PROVIDER=acs
# ACS_ENDPOINT=https://acs-tyluwa.europe.communication.azure.com
# ACS_KEY=
MAIL_FROM=DoNotReply@ty-luwa.nl
# MAIL_REPLY_TO=luuk-en-wanda@voorbeeld.nl
# MAIL_NOTIFY=luuk-en-wanda@voorbeeld.nl
# BACKUP_EMAIL=bjorn@voorbeeld.nl
